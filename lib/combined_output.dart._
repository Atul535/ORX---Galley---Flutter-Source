/// Call from main() once, before reverseLookup is built.
void registerAdditionalConfigs(Map<String, List<dynamic>> target) {
  // Keep this file stable; only add new modules here.
  registerEcbuConfig(target);
  // registerMaintenanceConfig(target);
  // registerWhateverConfig(target);
}

/// We store match rules keyed by `msgType`.
/// The `List<int>` represents the byte-by-byte rule codes for
/// the data portion of your command.
///
/// For instance, if your "DO" (0x10) commands look like:
///   [ <CAN ID>, <srcID?>, <msgType=0x10>, <someByte>, <someByte>...]
/// Then you define a pattern for each position in that array.
final Map<int, List<int>> matchRulesByMsgType = {
  0x10: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: bit subset
    0x02, // Byte6: bit subset
    0x02, // Byte7: bit subset
    0x02, // Byte8: bit subset
    0x02, // Byte9: bit subset
    0x02, // Byte10: bit subset
    0x02, // Byte11: bit subset
    0x02, // Byte12: bit subset
    0x02, // Byte13: bit subset
    0x02, // Byte14: bit subset
    0x00, // Byte15: ignore
    0x00, // Byte16: ignore

    // ... etc. You can add as many as you like,
    // or fill with 0x00 to ignore extra positions.
  ],
  0x11: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: bit subset
    0x02, // Byte6: bit subset
    0x02, // Byte7: bit subset
    0x02, // Byte8: bit subset
    0x02, // Byte9: bit subset
    0x02, // Byte10: bit subset
    0x02, // Byte11: bit subset
    0x02, // Byte12: bit subset
    0x02, // Byte13: bit subset
    0x02, // Byte14: bit subset
    0x00, // Byte15: ignore
    0x00, // Byte16: ignore
  ],
  0x13: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: bit subset
    0x02, // Byte6: bit subset
    0x00, // Byte7: ignore
    0x01, // Byte8: exact match
  ],
  0x15: [
    0x01, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: bit subset
    0x01, // Byte6: bit subset
    0x01, // Byte7: exact match
    0x01, // Byte8: ignore
    0x01, // Byte9: bit subset
    0x00, // Byte10: exact match
    0x00, // Byte11: exact match
    0x00,
  ],
  0x50: [
    0x02, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: bit subset
    0x02, // Byte6: bit subset
    0x01, // Byte7: exact match
    0x00, // Byte8: ignore
    0x01, // Byte9: bit subset
    0x01, // Byte10: exact match
    0x01, // Byte11: exact match
    0x01, // Byte12: exact match
    0x01, // Byte13: exact match
    0x01, // Byte14: exact match
    0x01, // Byte15: exact match
    0x01, // Byte16: exact match
  ],
  0x33: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x01, // Byte5: bit subset
    0x01, // Byte6: bit subset
    0x00, // Byte7: exact match
    0x02, // Byte8: ignore
    0x02, // Byte9: bit subset
    0x02, // Byte10: exact match
    0x02, // Byte11: exact match
    0x02, // Byte12: exact match
    0x02, // Byte13: exact match
    0x02, // Byte14: exact match
    0x02, // Byte15: exact match
    0x02, // Byte16: exact match
    0x02, // Byte16: exact match
    0x00,
    0x00,
    0x00,
  ],
  0x30: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x01, // Byte5: bit subset
    0x01, // Byte6: bit subset
    0x02, // Byte7: exact match
    0x02, // Byte8: ignore
    0x02, // Byte9: bit subset
    0x02, // Byte10: exact match
    0x02, // Byte11: exact match
    0x02, // Byte12: exact match
    0x02, // Byte13: exact match
    0x02, // Byte14: exact match
    0x02, // Byte15: exact match
    0x02, // Byte16: exact match
    0x02, // Byte16: exact match
    0x00,
    0x00,
    0x00,
  ],
  0x31: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x01, // Byte5: bit subset
    0x01, // Byte6: bit subset
    0x02, // Byte7: exact match
    0x02, // Byte8: ignore
    0x02, // Byte9: bit subset
    0x02, // Byte10: exact match
    0x02, // Byte11: exact match
    0x02, // Byte12: exact match
    0x02, // Byte13: exact match
    0x02, // Byte14: exact match
    0x02, // Byte15: exact match
    0x02, // Byte16: exact match
    0x02, // Byte16: exact match
    0x00,
    0x00,
    0x00,
  ],
  0x32: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x01, // Byte5: bit subset
    0x01, // Byte6: bit subset
    0x02, // Byte7: exact match
    0x02, // Byte8: ignore
    0x02, // Byte9: bit subset
    0x02, // Byte10: exact match
    0x02, // Byte11: exact match
    0x02, // Byte12: exact match
    0x02, // Byte13: exact match
    0x02, // Byte14: exact match
    0x02, // Byte15: exact match
    0x02, // Byte16: exact match
    0x02, // Byte16: exact match
    0x00,
    0x00,
    0x00,
  ],
  0x40: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x02, // Byte5: RS485 output
    0x01, // Byte6: addressing type
    0x02, // Byte7: grp 25-32
    0x02, // Byte8: grp 17-24
    0x02, // Byte9: grp 9-16
    0x02, // Byte10: grp 1-8
    0x01, // Byte11: light msg type +
    0x00, // Byte12: fade time
    0x01, // Byte13: on/off val
    0x01, // Byte14: brt MSB
    0x01, // Byte15: brt LSB
    0x04, // Byte16: Red
    0x04, // Byte17: Green
    0x04, // Byte18: Blue
    0x00,
    0x00,
  ],
  0x04: [
    0x00, // Byte1: ignore (example)
    0x01, // Byte2: must match exactly
    0x00, // Byte3: ignore
    0x00, // Byte4: ignore
    0x01, // Byte5: bit subset
  ],
  // etc...
};

