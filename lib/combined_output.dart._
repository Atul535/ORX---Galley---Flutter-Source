  Size? _imageSize;

  // ===== vertical group tabs =====
  static const List<TabSpec> _groupTabs = [
    TabSpec(
      id: 'ceiling',
      label: 'CEILING',
      flex: 20,
      iconAsset: 'assets/icons/icon_lightMid.png',
      iconSize: 60,
      iconPosition: Axis.horizontal,
    ),
    TabSpec(
      id: 'upwash',
      label: 'UPWASH',
      flex: 20,
      iconAsset: 'assets/icons/icon_lightMid.png',
      iconSize: 60,
      iconPosition: Axis.horizontal,
