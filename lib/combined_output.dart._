import 'dart:async';

import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../managers/global_touch_manager.dart';
import '../model/component_state.dart';
import '../model/enum_generic_selection_icon_text_side.dart';
import '../model/generic_selection.dart';
import '../model/image_state.dart';
import '../model/position_model.dart';
import '../providers/current_state_provider.dart';

import '../providers/custom_theme_provider.dart';
import '../model/theme/item_theme.dart';
import '../utils/logger.dart';
import 'cfg_image.dart';

// enum to define the side of the button in case we want to create a group of buttons
// we want to have button thats on the left side or right side or in the center of the group
enum GenericSelelectionWidgetButtonSide { left, right, middle, none }

class GenericSelectionWidget extends StatefulWidget {
  final String? id;
  final String? title;
  final List<IconData>? icons;
  final double iconSize;
  final String provider;
  final bool isMomentary;
  final String? route;
  final VoidCallback onStateCallBack;
  final VoidCallback offStateCallBack;
  final bool isSlider;
  final int delayMilliseconds;
  final double height;
  final double width;
  final double textIconSpacing;
  final Map<int, GenericSelectionState> states;
  final GenericSelelectionWidgetButtonSide side;
  final List<double> marginLRTB;
  final TextStyle? textStyle;
  final bool isNavigation;
  final Color? iconsColor;
  final List<Shadow>? iconsShadow;
  final Position? position;
  final bool isTransparent;
  final BorderRadius? borderRadius;
  final Color? color;
  final int? textWidgetFlex;
  final int? iconWidgetFlex;
  final List<double>? imageSize;
  final String? backgroundImage;
  final Alignment? textAlignment; // ⭐ NOVÝ - zarovnání textu
  final LinearGradient? textOverlayGradient; // ⭐ NOVÝ - gradient pod textem
  final LinearGradient? imageOverlayGradient; // ⭐ NOVÝ - gradient přes image
  final LinearGradient? imageOverlayGradientActive; // ⭐ NOVÝ - gradient když je aktivní
  final LinearGradient? imageOverlayGradientInactive;
  final bool removeBtnBackgroundStyling;
  final bool grayscaleWhenOff;
  final bool keepContentWhenTransparent;
  final String? customThemeKey;
  final StateThemeMap? customItemThemeByState;
  final bool iconTextInline;
  final GenericSelectionIconTextSide iconTextSide;
  final int inlineTextMaxLines;
  final TextOverflow inlineTextOverflow;
  final BoxFit imageFit;

  GenericSelectionWidget({
    Key? key,
    id,
    this.title,
    this.icons = const [],
    this.iconSize = 100,
    this.iconsColor,
    this.provider = "",
    this.isMomentary = false,
    this.route,
    this.onStateCallBack = emptyOnStateCallBack,
    this.offStateCallBack = emptyOffStateCallBack,
    this.isSlider = false,
    this.delayMilliseconds = 25,
    this.height = 150,
    this.width = 150,
    this.textIconSpacing = 10,
    this.side = GenericSelelectionWidgetButtonSide.none,
    this.marginLRTB = const [0.0, 0.0, 0.0, 0.0],
    this.textStyle,
    this.isNavigation = false,
    this.iconsShadow,
    this.position,
    this.isTransparent = false,
    this.borderRadius,
    this.color,
    this.textWidgetFlex,
    this.iconWidgetFlex,
    this.imageSize,
    this.backgroundImage,
    this.textAlignment,
    this.textOverlayGradient,
    this.removeBtnBackgroundStyling = false,
    this.imageOverlayGradient,
    this.imageOverlayGradientActive,
    this.imageOverlayGradientInactive,
    this.keepContentWhenTransparent = false,
    this.grayscaleWhenOff = false,
    this.customThemeKey,
    this.customItemThemeByState,
    this.iconTextInline = false,
    this.imageFit = BoxFit.fitHeight,
    this.iconTextSide = GenericSelectionIconTextSide.left,
    this.inlineTextMaxLines = 1,
    this.inlineTextOverflow = TextOverflow.ellipsis,
    Map<int, GenericSelectionState>? states,
  })  : id = id ?? UniqueKey().toString(),
        states = states ?? const {},
        super(key: key);

  // Creates a widget from a GenericSelection config item without breaking existing usages.
  // Existing constructor stays unchanged; this is just a convenience initializer.
  GenericSelectionWidget.fromSelection({
    Key? key,
    required GenericSelection item,

    // Optional overrides
    VoidCallback onStateCallBack = emptyOnStateCallBack,
    VoidCallback offStateCallBack = emptyOffStateCallBack,
    String provider = "",
    bool isNavigation = false,
    bool isTransparent = false,
    bool removeBtnBackgroundStyling = false,
    bool grayscaleWhenOff = false,
    bool keepContentWhenTransparent = false,
    StateThemeMap? customItemThemeByState,
    TextStyle? textStyle,
    Alignment? textAlignment,
    LinearGradient? textOverlayGradient,
    LinearGradient? imageOverlayGradient,
    LinearGradient? imageOverlayGradientActive,
    LinearGradient? imageOverlayGradientInactive,
  }) : this(
          key: key,
          id: item.id,
          title: item.title,
          icons: item.icons,
          iconSize: item.iconSize,
          height: item.height,
          width: item.width,
          textIconSpacing: item.textIconSpacing,
          borderRadius: item.borderRadius is BorderRadius ? item.borderRadius as BorderRadius : null,
          color: item.color,
          iconsColor: item.iconsColor,
          iconsShadow: item.iconsShadow,
          textStyle: textStyle,
          position: item.position,
          // marginLRTB: item.marginLRTB,
          provider: provider,
          isMomentary: item.isMomentary,
          route: item.route,
          onStateCallBack: onStateCallBack,
          offStateCallBack: offStateCallBack,
          isNavigation: isNavigation,
          isTransparent: isTransparent,
          removeBtnBackgroundStyling: removeBtnBackgroundStyling,
          grayscaleWhenOff: grayscaleWhenOff,
          keepContentWhenTransparent: keepContentWhenTransparent,
          customThemeKey: item.customThemeKey,
          customItemThemeByState: customItemThemeByState,
          states: item.states,
          textAlignment: textAlignment,
          textOverlayGradient: textOverlayGradient,
          imageOverlayGradient: imageOverlayGradient,
          imageOverlayGradientActive: imageOverlayGradientActive,
          imageOverlayGradientInactive: imageOverlayGradientInactive,
        );

  static void emptyOnStateCallBack() {}
  static void emptyOffStateCallBack() {}

  @override
  State<GenericSelectionWidget> createState() => _GenericSelectionWidgetState();
}

class _GenericSelectionWidgetState extends State<GenericSelectionWidget> {
  bool _released = false;
  Timer? _momentaryResetTimer;
  DateTime? _touchStartTime;
  bool _isHeld = false;
  bool _hasBeenHeldLongEnough = false;
  int? _primaryPointerId;
  bool _forceReset = false;

  void _navigateIfNeeded(BuildContext context, int currStateValue) {
    final String? route = widget.states[currStateValue]?.route;
    logDebug("GenericSelectionWidget", "Navigating to $route");
    if (route != null && route.isNotEmpty) {
      Navigator.of(context).pushNamed(route);
      _momentaryResetTimer?.cancel();
    }
  }

  void _resetMomentaryButton(BuildContext context) {
    if (widget.isMomentary && _isHeld) {
      _isHeld = false;
      Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
      widget.offStateCallBack();
      GlobalTouchManager.releaseTouch();
      logDebug("GenericSelectionWidget", "Force reset momentary button");
    }
  }

  TextAlign _getTextAlignFromAlignment(Alignment alignment) {
    if (alignment.x < -0.3) {
      return TextAlign.left;
    } else if (alignment.x > 0.3) {
      return TextAlign.right;
    } else {
      return TextAlign.center;
    }
  }

  @override
  void dispose() {
    _momentaryResetTimer?.cancel();
    super.dispose();
  }

  Widget _buildInlineIconText({
    required CustomTheme myTheme,
    required ItemTheme itemTheme,
    required int currStateValue,
    required List<IconData> currentStateIcons,
    required bool displayIcons,
    required bool displayImages,
    ImageState? currentImageState,
  }) {
    final String text = widget.states[currStateValue]?.title ?? widget.title ?? '';

    final TextStyle effectiveTextStyle = widget.textStyle?.copyWith(
          color: itemTheme.textColor ?? itemTheme.symbolColor,
          shadows: itemTheme.textShadows,
        ) ??
        (myTheme.textTheme?.titleLarge?.copyWith(
              color: itemTheme.textColor ?? itemTheme.symbolColor,
              shadows: itemTheme.textShadows,
            ) ??
            const TextStyle());

    // Icons to render (state icons > widget icons)
    final List<IconData> iconsToUse = currentStateIcons.isNotEmpty ? currentStateIcons : (widget.icons ?? const []);

    final List<Widget> iconWidgets = iconsToUse
        .map(
          (ic) => Icon(
            ic,
            size: widget.iconSize,
            color: widget.iconsColor ?? itemTheme.symbolColor,
            shadows: widget.iconsShadow ?? itemTheme.shadow,
          ),
        )
        .toList();

    // Optional image support (if you want inline image instead of icons)
    Widget? imageWidget;
    if (displayImages && currentImageState != null) {
      imageWidget = CfgImage(
        currentImageState.imagePath,
        width: widget.imageSize != null && widget.imageSize!.isNotEmpty ? widget.imageSize![0] : widget.iconSize,
        height: widget.imageSize != null && widget.imageSize!.length > 1 ? widget.imageSize![1] : widget.iconSize,
        fit: BoxFit.contain,
      );
    }

    final bool hasAnyIconOrImage = (displayIcons && iconWidgets.isNotEmpty) || (displayImages && imageWidget != null);
    final bool hasText = text.isNotEmpty;

    if (!hasAnyIconOrImage && !hasText) return const SizedBox.shrink();

    final spacing = SizedBox(width: widget.textIconSpacing);

    final textWidget = Flexible(
      child: Text(
        text,
        maxLines: widget.inlineTextMaxLines,
        overflow: widget.inlineTextOverflow,
        softWrap: false,
        textAlign: TextAlign.center,
        style: effectiveTextStyle,
      ),
    );

    // pick either icons row or image
    final Widget? leadingVisual = displayImages ? imageWidget : (iconWidgets.isNotEmpty ? Row(mainAxisSize: MainAxisSize.min, children: iconWidgets) : null);

    List<Widget> rowChildren;

    if (widget.iconTextSide == GenericSelectionIconTextSide.left) {
      rowChildren = [
        if (leadingVisual != null) leadingVisual,
        if (leadingVisual != null && hasText) spacing,
        if (hasText) textWidget,
      ];
    } else {
      rowChildren = [
        if (hasText) textWidget,
        if (leadingVisual != null && hasText) spacing,
        if (leadingVisual != null) leadingVisual,
      ];
    }

    return Center(
      child: Row(
        mainAxisSize: MainAxisSize.min,
        mainAxisAlignment: MainAxisAlignment.center,
        crossAxisAlignment: CrossAxisAlignment.center, // ✅ vertical align middle
        children: rowChildren,
      ),
    );
  }

  int _nextStateValue(int current) {
    // když nejsou definované stavy, fallback na původní toggle
    if (widget.states.isEmpty) {
      return current == 0 ? 1 : 0;
    }

    // seřazené klíče stavů (např. [0,1,2,5])
    final keys = widget.states.keys.toList()..sort();

    // chceme vždycky mít možnost vrátit se na 0
    // pokud není 0 definovaná, bereme "první" jako start a po posledním jdeme na něj
    final int zeroOrFirst = keys.contains(0) ? 0 : keys.first;

    // pokud current není mezi klíči:
    // - pokud current < první -> jdi na první
    // - pokud current > poslední -> jdi na 0 (nebo první, pokud 0 neexistuje)
    if (!keys.contains(current)) {
      if (current < keys.first) return keys.first;
      return zeroOrFirst;
    }

    final idx = keys.indexOf(current);
    if (idx < 0) return zeroOrFirst;

    // poslední -> zpět na 0 (nebo first)
    if (idx == keys.length - 1) return zeroOrFirst;

    // jinak další
    return keys[idx + 1];
  }

  @override
  Widget build(BuildContext context) {
    final CustomTheme myTheme = Provider.of<CustomThemes>(context, listen: true).getActiveTheme();

    Widget selectionContent = Selector<CurrentStateProvider, ({int state, bool isInhibited})>(
      selector: (context, provider) {
        final stateObject = provider.getCurrentStateObject(widget.id ?? '');
        return (state: stateObject.currentState, isInhibited: stateObject.isInhibited);
      },
      builder: (context, values, child) {
        final int currStateValue = values.state;
        final bool isActive = currStateValue == 1;
        final bool isInhibited = values.isInhibited;
        final bool isTouchDisabled = widget.states[currStateValue]?.touchDisabled ?? widget.states[0]?.touchDisabled ?? false;

        int textWidgetFlex = widget.isNavigation ? 5 : 2;
        int iconWidgetFlex = widget.isNavigation ? 2 : 5;

        if (widget.textWidgetFlex != null && widget.iconWidgetFlex != null) {
          logDebug(
            "GenericSelectionWidget",
            "Using custom flex values for text and icon widgets as ${widget.textWidgetFlex} and ${widget.iconWidgetFlex}",
          );
          textWidgetFlex = widget.textWidgetFlex!;
          iconWidgetFlex = widget.iconWidgetFlex!;
        }

        final ItemTheme itemTheme = myTheme.resolveSelectionTheme(
          state: currStateValue,
          themeKey: widget.customThemeKey ?? widget.id,
          override: widget.customItemThemeByState,
        );

        if (widget.id == "allLightsOn") {
          logInfo(
            "GenericSelectionWidget",
            "WidgetId: ${widget.id}, isActive: $isActive, isInhibited: $isInhibited, isTouchDisabled: $isTouchDisabled",
          );
        }

        final List<IconData> currentStateIcons = widget.states[currStateValue]?.icons ?? [];
        final List<ImageState> currentStateImages = widget.states[currStateValue]?.imageState ?? [];
        logInfo("GenericSelectionWidget", "WidgetIds:${widget.id}, Current State:$currStateValue");
        logInfo("GenericSelectionWidget", "Current State Images:$currentStateImages");

        bool displayIcons;
        bool displayImages;

        if (currentStateIcons.isNotEmpty) {
          displayIcons = true;
          displayImages = false;
          logInfo("GenericSelectionWidget", "Current State has Icons:$currentStateIcons");
        } else if (widget.icons != null && widget.icons!.isNotEmpty) {
          displayIcons = true;
          displayImages = false;
          logInfo("GenericSelectionWidget", "Widget has default Icons:${widget.icons}");
        } else if (currentStateImages.isNotEmpty) {
          displayIcons = false;
          displayImages = true;
          logInfo("GenericSelectionWidget", "Current State has Images:$currentStateImages");
        } else {
          displayIcons = false;
          displayImages = false;
          logInfo("GenericSelectionWidget", "No icons or images to display");
        }

        final ImageState? currentImageState = displayImages && currentStateImages.isNotEmpty ? currentStateImages[0] : null;
        final bool shouldGray = widget.grayscaleWhenOff && !isActive;

        final bool useOverlayText = !widget.isTransparent &&
            !widget.isNavigation &&
            widget.backgroundImage != null &&
            widget.textAlignment != null &&
            (widget.title != null || widget.states[currStateValue]?.title != null);

        LinearGradient? overlayGradient;
        if (!widget.isTransparent && widget.backgroundImage != null) {
          if (isActive && widget.imageOverlayGradientActive != null) {
            overlayGradient = widget.imageOverlayGradientActive;
          } else if (!isActive && widget.imageOverlayGradientInactive != null) {
            overlayGradient = widget.imageOverlayGradientInactive;
          } else {
            overlayGradient = widget.imageOverlayGradient;
          }
        }

        final BorderRadius? effectiveRadius = !widget.isTransparent && !widget.removeBtnBackgroundStyling
            ? (widget.side == GenericSelelectionWidgetButtonSide.left
                ? itemTheme.borderRadius?.copyWith(
                      topLeft: itemTheme.borderRadius?.topLeft ?? const Radius.circular(20),
                      bottomLeft: itemTheme.borderRadius?.bottomLeft ?? const Radius.circular(20),
                      topRight: Radius.zero,
                      bottomRight: Radius.zero,
                    ) ??
                    BorderRadius.only(
                      topLeft: itemTheme.borderRadius?.topRight ?? const Radius.circular(20),
                      bottomLeft: itemTheme.borderRadius?.bottomRight ?? const Radius.circular(20),
                      topRight: Radius.zero,
                      bottomRight: Radius.zero,
                    )
                : widget.side == GenericSelelectionWidgetButtonSide.right
                    ? itemTheme.borderRadius?.copyWith(
                          topRight: itemTheme.borderRadius?.topRight ?? const Radius.circular(20),
                          bottomRight: itemTheme.borderRadius?.bottomRight ?? const Radius.circular(20),
                          topLeft: Radius.zero,
                          bottomLeft: Radius.zero,
                        ) ??
                        BorderRadius.only(
                          topRight: itemTheme.borderRadius?.topLeft ?? const Radius.circular(20),
                          bottomRight: itemTheme.borderRadius?.bottomLeft ?? const Radius.circular(20),
                          topLeft: Radius.zero,
                          bottomLeft: Radius.zero,
                        )
                    : widget.side == GenericSelelectionWidgetButtonSide.middle
                        ? itemTheme.borderRadius?.copyWith(
                              topLeft: Radius.zero,
                              bottomLeft: Radius.zero,
                              topRight: Radius.zero,
                              bottomRight: Radius.zero,
                            ) ??
                            const BorderRadius.only(
                              topLeft: Radius.zero,
                              bottomLeft: Radius.zero,
                              topRight: Radius.zero,
                              bottomRight: Radius.zero,
                            )
                        : widget.borderRadius ?? itemTheme.borderRadius ?? BorderRadius.circular(20))
            : null;

        final Border? effectiveBorder = (!widget.isTransparent && !widget.removeBtnBackgroundStyling) ? itemTheme.border : null;

        Widget buildImageState() {
          if (!displayImages || currentImageState == null) {
            return const SizedBox.shrink();
          }

          return Flexible(
            flex: iconWidgetFlex,
            child: ColorFiltered(
              colorFilter: currentImageState.imageEffect == ImageEffect.grayscale
                  ? const ColorFilter.matrix(<double>[
                      0.2126,
                      0.7152,
                      0.0722,
                      0,
                      0,
                      0.2126,
                      0.7152,
                      0.0722,
                      0,
                      0,
                      0.2126,
                      0.7152,
                      0.0722,
                      0,
                      0,
                      0,
                      0,
                      0,
                      1,
                      0,
                    ])
                  : const ColorFilter.mode(Colors.transparent, BlendMode.dst),
              child: CfgImage(
                currentImageState.imagePath,
                width: widget.imageSize != null && widget.imageSize!.isNotEmpty ? widget.imageSize![0] : null,
                height: widget.imageSize != null && widget.imageSize!.length > 1 ? widget.imageSize![1] : null,
                fit: widget.imageFit,
              ),
            ),
          );
        }

        Widget buildIcons() {
          if (!displayIcons) {
            return const SizedBox.shrink();
          }

          return Flexible(
            flex: iconWidgetFlex,
            child: Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                ...List.generate(
                  currentStateIcons.isNotEmpty ? currentStateIcons.length : (widget.icons?.length ?? 0),
                  (index) => Icon(
                    currentStateIcons.isNotEmpty ? currentStateIcons[index] : widget.icons![index],
                    size: widget.iconSize,
                    color: widget.iconsColor ?? itemTheme.symbolColor,
                    shadows: widget.iconsShadow ?? itemTheme.shadow,
                  ),
                ),
              ],
            ),
          );
        }

        Widget buildNavigationTitle() {
          final String title = widget.states[currStateValue]?.title ?? widget.title ?? "";
          if (!widget.isNavigation || title.isEmpty) {
            return const SizedBox.shrink();
          }

          return Flexible(
            flex: textWidgetFlex,
            child: Text(
              title,
              textAlign: TextAlign.center,
              style: widget.textStyle?.copyWith(
                    color: itemTheme.textColor ?? itemTheme.symbolColor,
                    shadows: itemTheme.textShadows,
                  ) ??
                  myTheme.textTheme?.bodyMedium?.copyWith(
                    color: itemTheme.textColor ?? itemTheme.symbolColor,
                    shadows: itemTheme.textShadows,
                  ),
            ),
          );
        }

        Widget buildBottomText({required bool includeBottomText}) {
          final String title = widget.states[currStateValue]?.title ?? widget.title ?? "";
          if (widget.isNavigation || !includeBottomText || title.isEmpty) {
            return const SizedBox.shrink();
          }

          return Flexible(
            flex: textWidgetFlex,
            child: Text(
              title,
              textAlign: TextAlign.center,
              style: widget.textStyle?.copyWith(
                    color: itemTheme.textColor ?? itemTheme.symbolColor,
                    shadows: itemTheme.textShadows,
                  ) ??
                  myTheme.textTheme?.bodyMedium?.copyWith(
                    color: itemTheme.textColor ?? itemTheme.symbolColor,
                    shadows: itemTheme.textShadows,
                  ),
            ),
          );
        }

        Widget buildLegacyContent({required bool includeBottomText}) {
          return Flex(
            direction: Axis.vertical,
            mainAxisAlignment: (displayIcons || displayImages) ? MainAxisAlignment.spaceEvenly : MainAxisAlignment.center,
            children: [
              buildNavigationTitle(),
              buildIcons(),
              buildImageState(),
              buildBottomText(includeBottomText: includeBottomText),
            ],
          );
        }

        Widget buildOverlayTextContent() {
          return Stack(
            fit: StackFit.expand,
            children: [
              Center(
                child: Flex(
                  direction: Axis.vertical,
                  mainAxisAlignment: (displayIcons || displayImages) ? MainAxisAlignment.spaceEvenly : MainAxisAlignment.center,
                  children: [
                    buildNavigationTitle(),
                    buildIcons(),
                    buildImageState(),
                    Flexible(
                      flex: textWidgetFlex,
                      child: const SizedBox.shrink(),
                    ),
                  ],
                ),
              ),
              Align(
                alignment: widget.textAlignment!,
                child: Container(
                  width: double.infinity,
                  decoration: widget.textOverlayGradient != null ? BoxDecoration(gradient: widget.textOverlayGradient) : null,
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                  child: Text(
                    widget.states[currStateValue]?.title ?? widget.title ?? "",
                    textAlign: _getTextAlignFromAlignment(widget.textAlignment!),
                    style: widget.textStyle?.copyWith(
                          color: Colors.white,
                          shadows: [
                            Shadow(
                              color: Colors.black.withOpacity(0.8),
                              blurRadius: 4,
                              offset: const Offset(0, 2),
                            ),
                          ],
                        ) ??
                        const TextStyle(
                          color: Colors.white,
                          fontSize: 16,
                          fontWeight: FontWeight.bold,
                        ),
                  ),
                ),
              ),
            ],
          );
        }

        Widget buildForegroundContent() {
          if (widget.isTransparent && !widget.keepContentWhenTransparent) {
            return const SizedBox.shrink();
          }

          if (widget.iconTextInline) {
            return Center(
              child: _buildInlineIconText(
                myTheme: myTheme,
                itemTheme: itemTheme,
                currStateValue: currStateValue,
                currentStateIcons: currentStateIcons,
                displayIcons: displayIcons,
                displayImages: displayImages,
                currentImageState: currentImageState,
              ),
            );
          }

          return useOverlayText ? buildOverlayTextContent() : buildLegacyContent(includeBottomText: true);
        }

        Widget buildVisualBody(BoxConstraints constraints) {
          final bool wantsExpandedWidth = widget.width == double.infinity;
          final bool wantsExpandedHeight = widget.height == double.infinity;
          final bool canExpandWidth = wantsExpandedWidth && constraints.hasBoundedWidth;
          final bool canExpandHeight = wantsExpandedHeight && constraints.hasBoundedHeight;

          final double? effectiveWidth = wantsExpandedWidth ? null : widget.width;
          final double? effectiveHeight = wantsExpandedHeight ? null : widget.height;

          final BoxConstraints? effectiveConstraints = (canExpandWidth || canExpandHeight)
              ? BoxConstraints(
                  minWidth: canExpandWidth ? constraints.maxWidth : 0,
                  maxWidth: canExpandWidth ? constraints.maxWidth : double.infinity,
                  minHeight: canExpandHeight ? constraints.maxHeight : 0,
                  maxHeight: canExpandHeight ? constraints.maxHeight : double.infinity,
                )
              : null;

          return ColorFiltered(
            colorFilter: shouldGray
                ? const ColorFilter.matrix(<double>[
                    0.2126,
                    0.7152,
                    0.0722,
                    0,
                    0,
                    0.2126,
                    0.7152,
                    0.0722,
                    0,
                    0,
                    0.2126,
                    0.7152,
                    0.0722,
                    0,
                    0,
                    0,
                    0,
                    0,
                    1,
                    0,
                  ])
                : const ColorFilter.mode(Colors.transparent, BlendMode.dst),
            child: Container(
              width: effectiveWidth,
              height: effectiveHeight,
              constraints: effectiveConstraints,
              decoration: BoxDecoration(
                border: effectiveBorder,
                color: (!widget.isTransparent && !widget.removeBtnBackgroundStyling && widget.backgroundImage == null)
                    ? (widget.color != Colors.transparent ? (widget.color ?? itemTheme.backroundColor) : itemTheme.backroundColor)
                    : widget.color,
                gradient: (!widget.isTransparent && !widget.removeBtnBackgroundStyling && widget.backgroundImage == null) ? itemTheme.gradient : null,
                borderRadius: effectiveRadius,
                boxShadow: (!widget.isTransparent && !widget.removeBtnBackgroundStyling) ? itemTheme.boxShadow : null,
              ),
              clipBehavior: Clip.antiAlias,
              alignment: Alignment.center,
              child: Stack(
                fit: StackFit.expand,
                children: [
                  if (widget.backgroundImage != null)
                    CfgImage(
                      widget.backgroundImage!,
                      fit: BoxFit.cover,
                      alignment: Alignment.center,
                    ),
                  if (overlayGradient != null)
                    Container(
                      decoration: BoxDecoration(
                        gradient: overlayGradient,
                      ),
                    ),
                  buildForegroundContent(),
                ],
              ),
            ),
          );
        }

        Widget content = Listener(
          onPointerDown: (PointerDownEvent event) {
            logDebug("GenericSelectionWidget", "onPointerDown: pointer=${event.pointer}, kind=${event.kind}");
            if (_primaryPointerId == null) {
              _primaryPointerId = event.pointer;
            }
          },
          onPointerUp: (PointerUpEvent event) {
            logDebug("GenericSelectionWidget", "onPointerUp: pointer=${event.pointer}, primary=$_primaryPointerId");
            if (_primaryPointerId == event.pointer) {
              _primaryPointerId = null;
              if (widget.isMomentary && _isHeld) {
                Future.microtask(() => _resetMomentaryButton(context));
              }
            }
          },
          onPointerCancel: (PointerCancelEvent event) {
            logDebug("GenericSelectionWidget", "onPointerCancel: pointer=${event.pointer}, primary=$_primaryPointerId");
            if (_primaryPointerId == event.pointer) {
              _primaryPointerId = null;
              if (widget.isMomentary && _isHeld) {
                Future.microtask(() => _resetMomentaryButton(context));
              }
            }
          },
          child: GestureDetector(
            onPanDown: (details) {
              logDebug("GenericSelectionWidget **************************************", "onPanDown: Started");
              if (isTouchDisabled || isInhibited || !GlobalTouchManager.canTouch()) {
                logDebug("GenericSelectionWidget", "onPanDown: Touch disabled");
                return;
              }

              GlobalTouchManager.activateTouch();
              logDebug("GenericSelectionWidget", "onPanDown: Touch activated");
              _touchStartTime = DateTime.now();
              _hasBeenHeldLongEnough = false;
              _momentaryResetTimer?.cancel();

              if (!widget.isMomentary) {
                logDebug("GenericSelectionWidget", "onPanDown: Non-momentary button");
                if (isActive) {
                  widget.onStateCallBack();
                } else {
                  widget.offStateCallBack();
                }

                final next = _nextStateValue(currStateValue);
                logDebug("GenericSelectionWidget", "Changing state from $currStateValue to $next");
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), next);
                GlobalTouchManager.releaseTouch();
              } else {
                logDebug("GenericSelectionWidget", "onPanDown: Momentary button");
                _momentaryResetTimer?.cancel();
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 1);
                widget.onStateCallBack();
                _isHeld = true;
                _released = false;

                logDebug("GenericSelectionWidget", "onPanDown: Momentary button activated, starting timer");
                _momentaryResetTimer = Timer(const Duration(milliseconds: 250), () {
                  logDebug("GenericSelectionWidget", "onPanDown: Momentary button timer expired, release $_released");
                  _hasBeenHeldLongEnough = true;
                  if (_released) {
                    logDebug("GenericSelectionWidget", "onPanDown: Momentary button released before 250ms, resetting");
                    Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                    widget.offStateCallBack();
                    GlobalTouchManager.releaseTouch();
                  }
                });
              }

              logDebug("GenericSelectionWidget", "onPanDown: going to navigateIfNeeded");
              _navigateIfNeeded(context, currStateValue);
            },
            onPanUpdate: (details) {
              logDebug("GenericSelectionWidget", "onPanUpdate: Finger moved by ${details.delta.dx.abs()} and ${details.delta.dy.abs()}");
              if (widget.isMomentary && _isHeld && (details.delta.dx.abs() > 2 || details.delta.dy.abs() > 2)) {
                logDebug("GenericSelectionWidget", "onPanUpdate: Cancelling due to movement");
                _isHeld = false;
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                widget.offStateCallBack();
                GlobalTouchManager.releaseTouch();
              }
            },
            onHorizontalDragUpdate: (details) {
              if (widget.isMomentary) {
                _momentaryResetTimer?.cancel();
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                GlobalTouchManager.releaseTouch();
              }
            },
            onPanEnd: (details) {
              logDebug("GenericSelectionWidget", "onPanEnd: Started");
              if (widget.isMomentary) {
                final elapsedTime = DateTime.now().difference(_touchStartTime ?? DateTime.now()).inMilliseconds;
                _isHeld = false;
                if (elapsedTime < 250) {
                  final int remainingTime = 250 - elapsedTime;
                  logDebug("GenericSelectionWidget", "Quick tap detected! Ensuring active state for extra $remainingTime ms");

                  _momentaryResetTimer = Timer(Duration(milliseconds: remainingTime), () {
                    if (!_isHeld) {
                      Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                      widget.offStateCallBack();
                      logDebug("GenericSelectionWidget", "Momentary button released after delay");
                    }
                  });
                } else {
                  Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                  widget.offStateCallBack();
                }
              }
              _primaryPointerId = null;
              GlobalTouchManager.releaseTouch();
            },
            onLongPressCancel: () {
              logDebug("GenericSelectionWidget", "onLongPressCancel: Started");
              _released = true;
              _isHeld = false;
              if (!_hasBeenHeldLongEnough) {
                logDebug("GenericSelectionWidget", "onLongPressCancel: Ignored, button hasn't been held long enough.");
                return;
              }

              if (_momentaryResetTimer != null && _momentaryResetTimer!.isActive) {
                logDebug("GenericSelectionWidget", "onLongPressCancel: Canceling momentary reset timer");
                _momentaryResetTimer!.cancel();
              }

              if (widget.isMomentary) {
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                widget.offStateCallBack();
                logDebug("GenericSelectionWidget", "Momentary button canceled");
              }

              logDebug("GenericSelectionWidget", "onLongPressCancel: Touch released");
              GlobalTouchManager.releaseTouch();
            },
            onLongPressDown: (details) {
              logDebug("GenericSelectionWidget", "onLongPressDown: Started");
              if (isTouchDisabled || !GlobalTouchManager.canTouch()) {
                logDebug("GenericSelectionWidget", "onLongPressDown: Touch disabled");
                return;
              }

              GlobalTouchManager.activateTouch();
              _isHeld = true;

              if (widget.isMomentary) {
                logDebug("GenericSelectionWidget", "onLongPressDown: Momentary button");
                _momentaryResetTimer?.cancel();
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 1);
                widget.onStateCallBack();
              }
              _navigateIfNeeded(context, currStateValue);
            },
            onLongPressUp: () {
              logDebug("GenericSelectionWidget", "onLongPressUp: Started");
              if (isTouchDisabled) {
                return;
              }
              _isHeld = false;

              if (widget.isMomentary) {
                logDebug("GenericSelectionWidget", "onLongPressUp: Momentary button");
                Provider.of<CurrentStateProvider>(context, listen: false).setCurrentState(widget.id.toString(), 0);
                widget.offStateCallBack();
              }

              _primaryPointerId = null;
              GlobalTouchManager.releaseTouch();
            },
            child: Container(
              margin: EdgeInsets.fromLTRB(
                widget.marginLRTB[0],
                widget.marginLRTB[1],
                widget.marginLRTB[2],
                widget.marginLRTB[3],
              ),
              child: LayoutBuilder(
                builder: (context, constraints) => buildVisualBody(constraints),
              ),
            ),
          ),
        );

        if (isInhibited) {
          content = ShaderMask(
            shaderCallback: (bounds) {
              return const RadialGradient(
                colors: [Colors.grey, Colors.transparent],
                radius: 0.8,
              ).createShader(bounds);
            },
            blendMode: BlendMode.saturation,
            child: content,
          );
        }

        return AbsorbPointer(
          absorbing: isInhibited,
          child: content,
        );
      },
    );

    return widget.position != null
        ? Positioned(
            top: widget.position!.y,
            left: widget.position!.x,
            child: selectionContent,
          )
        : selectionContent;
  }
}

// END: widgets\generic_selection_widget.dart

// BEGIN: widgets\hold_to_action_button.dart
import 'dart:async';
import 'package:flutter/material.dart';

class HoldToActionButton extends StatefulWidget {
  final VoidCallback onHeldFor10Seconds;
  final Widget child;

  const HoldToActionButton({
    Key? key,
    required this.onHeldFor10Seconds,
    required this.child,
  }) : super(key: key);

  @override
  State<HoldToActionButton> createState() => _HoldToActionButtonState();
}

class _HoldToActionButtonState extends State<HoldToActionButton> {
  Timer? _timer;
  bool _isHeld = false;

  void _handleTapDown(TapDownDetails details) {
    // Mark the button as “being held”
    _isHeld = true;

    // Start the 10s timer
    _timer = Timer(const Duration(seconds: 2), () {
      if (_isHeld) {
        // If the button is still being held after 10s
        widget.onHeldFor10Seconds();
      }
    });
  }

  void _handleTapUp(TapUpDetails details) {
    // As soon as the user lifts their finger, cancel the timer
    _cancelTimer();
  }

  void _handleTapCancel() {
    // If some other event cancels the gesture, cancel
    _cancelTimer();
  }

  void _cancelTimer() {
    _isHeld = false;
    _timer?.cancel();
    _timer = null;
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTapDown: _handleTapDown,   // Start timing
      onTapUp: _handleTapUp,       // End timing
      onTapCancel: _handleTapCancel,
      child: widget.child,
    );
  }
}

// END: widgets\hold_to_action_button.dart

// BEGIN: widgets\inkwell_detector.dart
import 'package:flutter/material.dart';
import 'dart:async';

class InkWellDetector extends StatefulWidget {
  final Widget child;
  final VoidCallback onDelayedActivation;
  final int delayMilliseconds;

  const InkWellDetector({
    Key? key,
    required this.child,
    required this.onDelayedActivation,
    this.delayMilliseconds = 5, // Default to 50 milliseconds
  }) : super(key: key);

  @override
  State<InkWellDetector> createState() => _InkWellDetectorState();
}

class _InkWellDetectorState extends State<InkWellDetector> {
  Timer? _timer;
  bool _isPressed = false;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTapDown: (_) => _handleTapDown(),
      onTapUp: (_) => _handleTapUp(),
      onTapCancel: _handleTapCancel,
      child: widget.child,
    );
  }

  void _handleTapDown() {
    // logDebug("TouchDetector", "onTapDown");
    _isPressed = true;
    _timer = Timer(Duration(milliseconds: widget.delayMilliseconds), () {
      if (_isPressed) {
        widget.onDelayedActivation();
      }
    });
  }

  void _handleTapUp() {
    // logDebug("TouchDetector", "onTapUp");
    _isPressed = false;
    _timer?.cancel();
  }

  void _handleTapCancel() {
    // logDebug("TouchDetector", "TapCancel");
    _isPressed = false;
    _timer?.cancel();
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }
}

// END: widgets\inkwell_detector.dart

// BEGIN: widgets\joystick_widget.dart
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'dart:io';
import 'dart:math' as math;

import '../can-helpers/can_manager.dart';
import '../model/command.dart';
import '../model/component_state.dart';
import '../model/generic_selection.dart';
import '../providers/current_state_provider.dart';

class _GlowConfig {
  final bool enabled;
  final Color? color;
  final double blurRadius;
  final double spreadRadius;

  const _GlowConfig({
    required this.enabled,
    required this.color,
    required this.blurRadius,
    required this.spreadRadius,
  });

  factory _GlowConfig.fromJson(
    Map<String, dynamic>? json, {
    required double defaultBlur,
    required double defaultSpread,
  }) {
    if (json == null) {
      return _GlowConfig(
        enabled: false,
        color: null,
        blurRadius: defaultBlur,
        spreadRadius: defaultSpread,
      );
    }
    Color? color;
    if (json['color'] != null) {
      final parsed = int.tryParse(json['color'].toString());
      if (parsed != null) color = Color(parsed);
    }
    return _GlowConfig(
      enabled: true,
      color: color,
      blurRadius: (json['blur_radius'] as num?)?.toDouble() ?? defaultBlur,
      spreadRadius: (json['spread_radius'] as num?)?.toDouble() ?? defaultSpread,
    );
  }

  Color resolve(Color fallback) => color ?? fallback;
}

class _ShadowConfig {
  final bool enabled;
  final Color? color;
  final double blurRadius;
  final double offsetX;
  final double offsetY;

  const _ShadowConfig({
    required this.enabled,
    required this.color,
    required this.blurRadius,
    required this.offsetX,
    required this.offsetY,
  });

  factory _ShadowConfig.fromJson(Map<String, dynamic>? json) {
    if (json == null) {
      return const _ShadowConfig(
        enabled: false,
        color: null,
        blurRadius: 6,
        offsetX: 0,
        offsetY: 3,
      );
    }
    Color? color;
    if (json['color'] != null) {
      final parsed = int.tryParse(json['color'].toString());
      if (parsed != null) color = Color(parsed);
    }
    return _ShadowConfig(
      enabled: true,
      color: color,
      blurRadius: (json['blur_radius'] as num?)?.toDouble() ?? 6,
      offsetX: (json['offset_x'] as num?)?.toDouble() ?? 0,
      offsetY: (json['offset_y'] as num?)?.toDouble() ?? 3,
    );
  }

  Color resolve(Color fallback) => color ?? fallback;
}

class JoystickWidget extends StatefulWidget {
  final Map<String, dynamic>? json;
  // New config-based input
  final GenericSelection? item;

  // true = send directly to CAN like ColorPicker
  // false = only update CurrentStateProvider
  final bool sendDirectlyToCan;

  final Function(List<Command>, String)? sendCommandCallback;

  const JoystickWidget({
    super.key,
    this.json,
    this.item,
    this.sendDirectlyToCan = true,
    this.sendCommandCallback,
  });

  @override
  State<JoystickWidget> createState() => _JoystickWidgetState();
}

class _JoystickWidgetState extends State<JoystickWidget> with SingleTickerProviderStateMixin {
  File? _backgroundImageFile;
  File? _knobImageFile;

  Offset _knobOffset = Offset.zero;
  int? _currentStateId;

  late final double _outerRadius;
  late final double _knobRadius;
  late final double _deadZonePct;
  late final double _slowMaxPct;
  late final bool _springBack;
  late final Map<int, GenericSelectionState> _selectionStates;
  final CanManager _canManager = CanManager();
  late final bool _showKnobHighlight;

  late final _GlowConfig _outerGlow;
  late final _GlowConfig _knobGlow;
  late final _ShadowConfig _knobShadow;

  Map<String, dynamic>? _resetButton;

  late final AnimationController _snapCtrl;
  late Animation<Offset> _snapAnim;

  Offset? _widgetCenterGlobal;

  @override
  void initState() {
    super.initState();

    final double size = (widget.json?['size'] as num?)?.toDouble() ?? 300.0;
    final double knobSize = (widget.json?['knob_size'] as num?)?.toDouble() ?? 84.0;
    _outerRadius = size / 2;
    _knobRadius = knobSize / 2;
    _deadZonePct = (widget.json?['dead_zone'] as num?)?.toDouble() ?? 10.0;
    _slowMaxPct = (widget.json?['slow_max'] as num?)?.toDouble() ?? 50.0;
    _selectionStates = widget.item?.states ?? {};
    _springBack = widget.json?['spring_back'] as bool? ?? true;
    _showKnobHighlight = widget.json?['show_knob_highlight'] as bool? ?? false;

    _outerGlow = _GlowConfig.fromJson(
      widget.json?['outer_glow'] as Map<String, dynamic>?,
      defaultBlur: 20,
      defaultSpread: 4,
    );
    _knobGlow = _GlowConfig.fromJson(
      widget.json?['knob_glow'] as Map<String, dynamic>?,
      defaultBlur: 14,
      defaultSpread: 1,
    );
    _knobShadow = _ShadowConfig.fromJson(
      widget.json?['knob_shadow'] as Map<String, dynamic>?,
    );

    _resetButton = !_springBack ? (widget.json?['reset_button'] as Map<String, dynamic>?) : null;

    _snapCtrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 350),
    );
    _snapAnim = AlwaysStoppedAnimation(Offset.zero);
    _snapCtrl.addListener(() {
      setState(() => _knobOffset = _snapAnim.value);
    });

    final String? bgKey = widget.json?['background_image'] as String?;
    if (bgKey != null) {
      //TBD _backgroundImageFile = _imageDownloadController.resolveImage(bgKey);
    }
    final String? knobKey = widget.json?['knob_image'] as String?;
    if (knobKey != null) {
      //TBD _knobImageFile = _imageDownloadController.resolveImage(knobKey);
    }

    WidgetsBinding.instance.addPostFrameCallback((_) {
      //TBD _commandController.updateWidgetJson(widgetJson: widget.json);
    });
  }

  @override
  void dispose() {
    _snapCtrl.dispose();
    super.dispose();
  }

  void _handleReset() {
    _snapAnim = Tween<Offset>(
      begin: _knobOffset,
      end: Offset.zero,
    ).animate(CurvedAnimation(parent: _snapCtrl, curve: Curves.easeOutCubic));

    _snapCtrl.forward(from: 0.0);

    if (_currentStateId != 0) {
      _currentStateId = 0;
      _sendCommandsForState(0);
    }
  }

  int _resolveState(Offset clampedOffset) {
    final double distancePct = (clampedOffset.distance / _outerRadius) * 100.0;
    if (distancePct <= _deadZonePct) return 0;

    final double angleRad = math.atan2(clampedOffset.dy, clampedOffset.dx);
    double angleDeg = (angleRad * 180.0 / math.pi) + 90.0;
    if (angleDeg < 0) angleDeg += 360.0;
    if (angleDeg >= 360) angleDeg -= 360.0;

    final int sector = ((angleDeg + 22.5) / 45.0).floor() % 8;
    return distancePct <= _slowMaxPct ? sector + 1 : sector + 9;
  }

  void _dispatchCommands(List<Command> commands) {
    if (commands.isEmpty) return;

    final String originId = widget.item?.id ?? widget.json?['id']?.toString() ?? 'joystick';

    final List<Command> copiedCommands = commands
        .map(
          (command) => Command(
            id: command.id,
            canIdBF: command.canIdBF,
            data: List<int>.from(command.data),
          ),
        )
        .toList();

    if (widget.sendCommandCallback != null) {
      widget.sendCommandCallback!(copiedCommands, originId);
      return;
    }

    if (widget.sendDirectlyToCan) {
      _canManager.sendCommand(
        commands: copiedCommands,
        originId: originId,
      );
    }
  }

  void _sendCommandsForState(int stateId) {
    final String originId = widget.item?.id ?? widget.json?['id']?.toString() ?? 'joystick';

    Provider.of<CurrentStateProvider>(
      context,
      listen: false,
    ).setCurrentState(originId, stateId);

    if (!widget.sendDirectlyToCan) return;

    final GenericSelectionState? state = _selectionStates[stateId];
    if (state == null) {
      debugPrint('[Joystick] Missing config state $stateId for $originId');
      return;
    }

    _dispatchCommands(state.commands);
  }

  void _handlePanDown(DragDownDetails details) {
    _snapCtrl.stop();
    final box = context.findRenderObject() as RenderBox?;
    if (box == null) return;
    final size = box.size;
    _widgetCenterGlobal = box.localToGlobal(
      Offset(size.width / 2, size.height / 2),
    );
  }

  void _handlePanUpdate(DragUpdateDetails details) {
    if (_widgetCenterGlobal == null) return;
    final Offset delta = details.globalPosition - _widgetCenterGlobal!;
    final Offset clamped = delta.distance <= _outerRadius ? delta : Offset.fromDirection(delta.direction, _outerRadius);

    setState(() => _knobOffset = clamped);

    final int matchedId = _resolveState(clamped);
    if (matchedId != _currentStateId) {
      _currentStateId = matchedId;
      debugPrint('[Joystick] → state $matchedId');
      _sendCommandsForState(matchedId);
    }
  }

  void _handlePanEnd(DragEndDetails _) {
    _widgetCenterGlobal = null;
    if (_springBack) {
      _snapAnim = Tween<Offset>(
        begin: _knobOffset,
        end: Offset.zero,
      ).animate(CurvedAnimation(parent: _snapCtrl, curve: Curves.easeOutCubic));
      _snapCtrl.forward(from: 0.0);
      if (_currentStateId != 0) {
        _currentStateId = 0;
        _sendCommandsForState(0);
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final double diameter = _outerRadius * 2;
    final double knobDiameter = _knobRadius * 2;

    Color.fromARGB(255, 95, 95, 95);

    final Color outerColor = Color(
      int.tryParse(widget.json?['outer_color'] ?? '0xFF313136') ?? 0xFF313136,
    );
    final Color knobColor = Color(
      int.tryParse(widget.json?['knob_color'] ?? '0xFF898989') ?? 0xFF898989,
    );
    final Color knobHighlightColor = Color(
      int.tryParse(widget.json?['knob_highlight_color'] ?? '0xFF5F5F5F') ?? 0xFF5F5F5F,
    );

    final Color outerGlowColor = _outerGlow.resolve(outerColor);
    final Color knobGlowColor = _knobGlow.resolve(knobColor);
    final Color knobShadowColor = _knobShadow.resolve(Colors.black);

    final bool showCrosshair = widget.json?['show_crosshair'] as bool? ?? true;
    final String? label = widget.json?['label'] as String?;
    final double slowRingFraction = _slowMaxPct / 100.0;

    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        if (label != null && label.isNotEmpty) ...[
          Text(
            label,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 16,
              fontWeight: FontWeight.w600,
              letterSpacing: 1.2,
            ),
          ),
          const SizedBox(height: 12),
        ],
        GestureDetector(
          behavior: HitTestBehavior.opaque,
          onPanDown: _handlePanDown,
          onPanUpdate: _handlePanUpdate,
          onPanEnd: _handlePanEnd,
          onTapDown: (_) {
            if (_currentStateId != 0) {
              _currentStateId = 0;
              _sendCommandsForState(0);
            } else {
              // This also allows repeated center tap to send center command again.
              _sendCommandsForState(0);
            }
          },
          child: SizedBox(
            width: diameter,
            height: diameter,
            child: Stack(
              clipBehavior: Clip.none,
              children: [
                Positioned.fill(
                  child: Container(
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: _backgroundImageFile != null ? null : outerColor,
                      image: _backgroundImageFile != null
                          ? DecorationImage(
                              image: FileImage(_backgroundImageFile!),
                              fit: BoxFit.cover,
                            )
                          : null,
                      border: _backgroundImageFile != null ? null : Border.all(color: outerColor, width: 2),
                      boxShadow: _outerGlow.enabled
                          ? [
                              BoxShadow(
                                color: outerGlowColor,
                                blurRadius: _outerGlow.blurRadius,
                                spreadRadius: _outerGlow.spreadRadius,
                              ),
                            ]
                          : null,
                    ),
                  ),
                ),
                Positioned.fill(
                  child: ClipOval(
                    child: CustomPaint(
                      painter: _JoystickGuidePainter(
                        color: outerColor,
                        deadZoneFraction: _deadZonePct / 100.0,
                        slowRingFraction: slowRingFraction,
                        showCrosshair: showCrosshair,
                      ),
                    ),
                  ),
                ),
                if (_currentStateId != null && _currentStateId != 0)
                  Positioned.fill(
                    child: ClipOval(
                      child: CustomPaint(
                        painter: _ActiveSectorPainter(
                          stateId: _currentStateId!,
                          slowRingFraction: slowRingFraction,
                          deadZoneFraction: _deadZonePct / 100.0,
                          color: knobHighlightColor,
                        ),
                      ),
                    ),
                  ),
                Positioned.fill(
                  child: Center(
                    child: Transform.translate(
                      offset: _knobOffset,
                      child: Container(
                        width: knobDiameter,
                        height: knobDiameter,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          image: _knobImageFile != null
                              ? DecorationImage(
                                  image: FileImage(_knobImageFile!),
                                  fit: BoxFit.cover,
                                )
                              : null,
                          gradient: _knobImageFile != null
                              ? null
                              : RadialGradient(
                                  colors: [knobColor, knobColor],
                                  center: const Alignment(-0.3, -0.3),
                                ),
                          boxShadow: [
                            if (_knobGlow.enabled)
                              BoxShadow(
                                color: knobGlowColor,
                                blurRadius: _knobGlow.blurRadius,
                                spreadRadius: _knobGlow.spreadRadius,
                              ),
                            if (_knobShadow.enabled)
                              BoxShadow(
                                color: knobShadowColor,
                                blurRadius: _knobShadow.blurRadius,
                                offset: Offset(
                                  _knobShadow.offsetX,
                                  _knobShadow.offsetY,
                                ),
                              ),
                          ],
                        ),
                        child: _showKnobHighlight
                            ? Center(
                                child: Container(
                                  width: knobDiameter * 0.22,
                                  height: knobDiameter * 0.22,
                                  decoration: const BoxDecoration(
                                    shape: BoxShape.circle,
                                    color: Colors.white,
                                  ),
                                ),
                              )
                            : null,
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
        if (_resetButton != null) ...[
          const SizedBox(height: 16),
          _ResetButton(
            width: widget.json?['size'] != null ? (widget.json?['size'] as num).toDouble() * 0.8 : 160.0,
            label: _resetButton!['label'] as String? ?? 'RESET',
            color: Color(
              int.tryParse(_resetButton!['color'] ?? '0xFF3B6ABA') ?? 0xFF3B6ABA,
            ),
            textColor: Color(
              int.tryParse(_resetButton!['text_color'] ?? '0xFFFFFFFF') ?? 0xFFFFFFFF,
            ),
            onTap: _handleReset,
          ),
        ],
      ],
    );
  }
}

class _ResetButton extends StatelessWidget {
  final String label;
  final Color color;
  final Color textColor;
  final VoidCallback onTap;
  final double width;

  const _ResetButton({
    required this.label,
    required this.color,
    required this.textColor,
    required this.onTap,
    required this.width,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        width: width,
        padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 10),
        decoration: BoxDecoration(
          color: color,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: color, width: 1.5),
          boxShadow: [BoxShadow(color: color, blurRadius: 10, spreadRadius: 1)],
        ),
        child: Center(
          child: Text(
            label,
            style: TextStyle(
              color: textColor,
              fontSize: 13,
              fontWeight: FontWeight.w700,
              letterSpacing: 1.5,
            ),
          ),
        ),
      ),
    );
  }
}

class _JoystickGuidePainter extends CustomPainter {
  final Color color;
  final double deadZoneFraction;
  final double slowRingFraction;
  final bool showCrosshair;

  const _JoystickGuidePainter({
    required this.color,
    required this.deadZoneFraction,
    required this.slowRingFraction,
    required this.showCrosshair,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.0;

    final center = Offset(size.width / 2, size.height / 2);
    final outerR = size.width / 2;

    canvas.drawCircle(center, outerR * slowRingFraction, paint);

    if (showCrosshair) {
      canvas.drawCircle(center, outerR * deadZoneFraction, paint);

      canvas.drawLine(
        Offset(0, center.dy),
        Offset(size.width, center.dy),
        paint,
      );
      canvas.drawLine(
        Offset(center.dx, 0),
        Offset(center.dx, size.height),
        paint,
      );

      for (final angle in [45.0, 135.0, 225.0, 315.0]) {
        final rad = angle * math.pi / 180.0;
        canvas.drawLine(
          center,
          Offset(
            center.dx + outerR * math.cos(rad),
            center.dy + outerR * math.sin(rad),
          ),
          paint,
        );
      }
    }
  }

  @override
  bool shouldRepaint(_JoystickGuidePainter old) =>
      old.color != color || old.deadZoneFraction != deadZoneFraction || old.slowRingFraction != slowRingFraction || old.showCrosshair != showCrosshair;
}

class _ActiveSectorPainter extends CustomPainter {
  final int stateId;
  final double slowRingFraction;
  final double deadZoneFraction;
  final Color color;

  const _ActiveSectorPainter({
    required this.stateId,
    required this.slowRingFraction,
    required this.deadZoneFraction,
    required this.color,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (stateId == 0) return;

    final center = Offset(size.width / 2, size.height / 2);
    final outerR = size.width / 2;

    final bool isFast = stateId >= 9;
    final int sectorIdx = isFast ? stateId - 9 : stateId - 1;

    final double innerR = isFast ? outerR * slowRingFraction : outerR * deadZoneFraction;
    final double outerRing = isFast ? outerR : outerR * slowRingFraction;

    final double startDeg = sectorIdx * 45.0 - 22.5 - 90.0;
    final double startRad = startDeg * math.pi / 180.0;
    const double sweepRad = 45.0 * math.pi / 180.0;
    final double endRad = startRad + sweepRad;

    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.fill;

    final path = Path();
    path.moveTo(
      center.dx + outerRing * math.cos(startRad),
      center.dy + outerRing * math.sin(startRad),
    );
    path.arcTo(
      Rect.fromCircle(center: center, radius: outerRing),
      startRad,
      sweepRad,
      false,
    );
    path.lineTo(
      center.dx + innerR * math.cos(endRad),
      center.dy + innerR * math.sin(endRad),
    );
    path.arcTo(
      Rect.fromCircle(center: center, radius: innerR),
      endRad,
      -sweepRad,
      false,
    );
    path.close();

    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(_ActiveSectorPainter old) =>
      old.stateId != stateId || old.slowRingFraction != slowRingFraction || old.deadZoneFraction != deadZoneFraction || old.color != color;
}

// END: widgets\joystick_widget.dart

// BEGIN: widgets\lazy_indexed_stack.dart
import 'package:flutter/material.dart';

/// Lazy alternative to IndexedStack:
/// - Builds only the active child initially.
/// - Builds other children only after they were visited.
/// - Keeps already built children alive (no re-build on tab switch).
class LazyIndexedStack extends StatefulWidget {
  final int index;
  final List<WidgetBuilder> builders;

  const LazyIndexedStack({
    super.key,
    required this.index,
    required this.builders,
  });

  @override
  State<LazyIndexedStack> createState() => _LazyIndexedStackState();
}

class _LazyIndexedStackState extends State<LazyIndexedStack> {
  late final List<bool> _built;

  @override
  void initState() {
    super.initState();
    _built = List<bool>.filled(widget.builders.length, false);
    _built[widget.index] = true;
  }

  @override
  void didUpdateWidget(covariant LazyIndexedStack oldWidget) {
    super.didUpdateWidget(oldWidget);

    // Mark current index as built when user switches tabs.
    final i = widget.index;
    if (i >= 0 && i < _built.length && !_built[i]) {
      _built[i] = true;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Stack(
      children: List.generate(widget.builders.length, (i) {
        if (!_built[i]) {
          // Not built yet → keep it out of the tree.
          return const SizedBox.shrink();
        }

        final active = i == widget.index;

        return Offstage(
          offstage: !active,
          child: TickerMode(
            enabled: active,
            child: widget.builders[i](context),
          ),
        );
      }),
    );
  }
}
// END: widgets\lazy_indexed_stack.dart

