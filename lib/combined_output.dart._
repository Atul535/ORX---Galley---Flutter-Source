                                                              iconSize: 45,
                                                              isMomentary: itemObjects['sterilizer1_advanced']!.isMomentary,

                                                              // ✅ otevře popup, a tím pádem už se neprovede default toggle logika

                                                              // původní callbacky můžeš nechat prázdné, když se klik přesměruje
                                                              onStateCallBack: () {},
