                                    ? LinearGradient(
                                        begin: Alignment.centerLeft,
                                        end: Alignment.bottomRight,
                                        colors: [
                                          Colors.transparent, // Průhledné nahoře
                                          Colors.black.withOpacity(0.7), // Tmavé dole (pro text)
                                        ],
                                        stops: [0.0, 1.0], // Gradient začíná až v polovině
                                      )
                                    : null,
                              );
                            }).toList();

                            return Row(
